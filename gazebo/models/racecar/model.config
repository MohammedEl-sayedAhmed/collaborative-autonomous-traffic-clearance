<?xml version="1.0"?>
<model>
  <name>racecar</name>
  <version>0.1</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>Mohammed El-sayed Ahmed</name></author>
  <description>
    A 1/10-scale F1TENTH-style car for the M5 spike: the f1tenth_gym car's numbers (mass 3.74 kg,
    wheelbase 0.3302 m, width 0.31 m, steering limit 0.4189 rad) on the 2020 racecar's layout (rear
    wheels driven, front wheels on steering hinges, a Hokuyo-style lidar). Boxes and cylinders for
    now; the 2020 meshes come in M5.1. Origin at the centre of gravity, like f1tenth_gym.
  </description>
</model>
