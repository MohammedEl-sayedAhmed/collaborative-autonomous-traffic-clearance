<?xml version="1.0"?>
<sdf version="1.9">
  <model name="racecar">
    <!-- Origin at the centre of gravity, z = wheel radius so the wheels touch the ground. -->
    <link name="chassis">
      <inertial><mass>3.74</mass><inertia><ixx>0.0330678</ixx><iyy>0.107961</iyy><izz>0.134796</izz></inertia></inertial>
      <collision name="c"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>0.58 0.31 0.1</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.03 0 0 0</pose><geometry><box><size>0.58 0.31 0.1</size></box></geometry>
        <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      <sensor name="lidar" type="gpu_lidar">
        <!-- Hokuyo UST-10LX as the 2020 model had it: 1081 points over 270 degrees, 0.1 to 10 m, 40 Hz -->
        <pose>0.09355 0 0.115 0 0 0</pose>
        <update_rate>40</update_rate>
        <lidar>
          <scan><horizontal><samples>1081</samples><resolution>1</resolution>
            <min_angle>-2.3561944902</min_angle><max_angle>2.3561944902</max_angle></horizontal></scan>
          <range><min>0.1</min><max>10.0</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>1</always_on><visualize>0</visualize>
      </sensor>
    </link>
    
    <link name="rear_left_wheel">
      <pose>-0.17145 0.1 0 1.5708 0 0</pose>
      <inertial><mass>0.34</mass><inertia><ixx>0.000269875</ixx><iyy>0.000269875</iyy><izz>0.000425</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    
    <link name="rear_right_wheel">
      <pose>-0.17145 -0.1 0 1.5708 0 0</pose>
      <inertial><mass>0.34</mass><inertia><ixx>0.000269875</ixx><iyy>0.000269875</iyy><izz>0.000425</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    
    <link name="front_left_hinge">
      <pose>0.15875 0.1 0 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>4e-6</ixx><iyy>4e-6</iyy><izz>4e-6</izz></inertia></inertial>
    </link>
    
    <link name="front_right_hinge">
      <pose>0.15875 -0.1 0 0 0 0</pose>
      <inertial><mass>0.1</mass><inertia><ixx>4e-6</ixx><iyy>4e-6</iyy><izz>4e-6</izz></inertia></inertial>
    </link>
    
    <link name="front_left_wheel">
      <pose>0.15875 0.1 0 1.5708 0 0</pose>
      <inertial><mass>0.34</mass><inertia><ixx>0.000269875</ixx><iyy>0.000269875</iyy><izz>0.000425</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>
    
    <link name="front_right_wheel">
      <pose>0.15875 -0.1 0 1.5708 0 0</pose>
      <inertial><mass>0.34</mass><inertia><ixx>0.000269875</ixx><iyy>0.000269875</iyy><izz>0.000425</izz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
    </link>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_left_steer_joint" type="revolute">
      <parent>chassis</parent><child>front_left_hinge</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.4189</lower><upper>0.4189</upper><effort>10</effort></limit></axis>
    </joint>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>chassis</parent><child>front_right_hinge</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.4189</lower><upper>0.4189</upper><effort>10</effort></limit></axis>
    </joint>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_hinge</parent><child>front_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_hinge</parent><child>front_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Gazebo's own Ackermann steering: a Twist in (linear.x = speed, angular.z = yaw rate),
         the wheel and steering joints driven. The spike turns (steer, speed) into that Twist.
         No <topic> on purpose: the defaults are per model, /model/<name>/cmd_vel and
         /model/<name>/odometry, so several included cars do not share one topic. -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>0.2</kingpin_width>
      <steering_limit>0.4189</steering_limit>
      <wheel_base>0.3302</wheel_base>
      <wheel_separation>0.2</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <min_velocity>-2</min_velocity><max_velocity>20</max_velocity>
      <min_acceleration>-9.51</min_acceleration><max_acceleration>9.51</max_acceleration>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>100</update_frequency>
    </plugin>
  </model>
</sdf>
