<?xml version="1.0"?>
<sdf version="1.9">
  <world name="spike">
    <!-- 1 ms physics, run as fast as possible; the bridge steps it in lockstep. -->
    <physics name="1ms" type="dart"><max_step_size>0.001</max_step_size><real_time_factor>0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="CaatcLockstepPlant" name="caatc::LockstepPlant">
      <model>car1</model>
      <model>car2</model>
      <model>car3</model>
      <model>car4</model>
      <wheel_radius>0.05</wheel_radius><wheel_base>0.3302</wheel_base><track_width>0.2</track_width>
      <steer_max>0.4189</steer_max><steer_rate_max>3.2</steer_rate_max><steer_gain>30</steer_gain>
      <accel_max>9.51</accel_max><speed_max>20</speed_max>
    </plugin>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.5 0.1 -0.9</direction><diffuse>0.8 0.8 0.8 1</diffuse></light>
    <model name="ground"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link></model>
    <!-- two low walls, 1.6 m either side of the centreline, so the lidar sees something -->
    <model name="wall_left"><static>true</static><pose>0 1.6 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>80 0.1 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>80 0.1 0.3</size></box></geometry></visual></link></model>
    <model name="wall_right"><static>true</static><pose>0 -1.6 0.15 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>80 0.1 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>80 0.1 0.3</size></box></geometry></visual></link></model>
    
    <include>
      <uri>model://racecar</uri>
      <name>car1</name>
      <pose>-2.0 0 0.05 0 0 0</pose>
    </include>

    <include>
      <uri>model://racecar</uri>
      <name>car2</name>
      <pose>-4.0 0 0.05 0 0 0</pose>
    </include>

    <include>
      <uri>model://racecar</uri>
      <name>car3</name>
      <pose>-6.0 0 0.05 0 0 0</pose>
    </include>

    <include>
      <uri>model://racecar</uri>
      <name>car4</name>
      <pose>-8.0 0 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>
