# ---- catkin / ROS / Docker (containerized build) ----
# Build products belong in the Docker volume, never in the repo.
/build/
/devel/
/install/
.catkin_workspace

# Python bytecode (Gazebo/ROS write these into the source tree at runtime)
__pycache__/
*.py[cod]

# RL training run outputs + saved Q-tables (local experiment data, read by the dashboard)
**/saved_variables/

# ROS logs / bags
*.log
*.bag

# ---- LaTeX build artifacts (thesis/) ----
# The compiled thesis/main.pdf IS tracked (each commit ships its PDF); these
# intermediates are not. Extension-based, so *.pdf figures/main.pdf are kept.
# (*.log and *.out are already ignored by the ROS/upstream rules above.)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.toc
*.run.xml
*.synctex.gz
*.glo
*.gls
*.glg
*.ist
*.acn
*.acr
*.alg
*.idx
*.ind
*.ilg
*.xdv

# editor / OS cruft
*.swp
.DS_Store

# ---- original C/C++ artifact ignores (from upstream) ----
# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
